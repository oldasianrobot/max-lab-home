{
  "redirects": [
    {
      "source": "/oracle",
      "destination": "/oracle/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/oracle/",
      "destination": "https://oracle-and-the-below.vercel.app/"
    },
    {
      "source": "/oracle/:path*",
      "destination": "https://oracle-and-the-below.vercel.app/:path*"
    }
  ]
}
